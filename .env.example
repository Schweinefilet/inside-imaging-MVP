# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real secrets.

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED in production — app refuses to start without it.
SECRET_KEY=your-secret-key-here

# ── Flask environment ─────────────────────────────────────────────────────────
# Set to "production" on the server; leave as "development" locally.
FLASK_ENV=development

# ── PHI / HIPAA ───────────────────────────────────────────────────────────────
# Options: pseudonymize | full_deidentify | passthrough
# WARNING: passthrough stores raw PHI and is NOT HIPAA-safe for production.
PHI_MODE=pseudonymize

# ── Storage ───────────────────────────────────────────────────────────────────
# Options: s3 | local
# WARNING: local storage is NOT encrypted at rest — use s3 for production.
STORAGE_BACKEND=s3
# Set to 'local' for development without AWS credentials.
# S3_BUCKET=your-bucket-name
# S3_KMS_KEY_ID=                    # optional: use KMS key instead of AES256
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key

# ── Database encryption (SQLCipher) ───────────────────────────────────────────
# Encrypts the SQLite database file at rest.
# Setup steps:
#   1. Install system library: brew install sqlcipher  (or apt install libsqlcipher-dev)
#   2. Install Python package:  pip install sqlcipher3
#   3. Generate a key:          python -c "import secrets; print(secrets.token_hex(32))"
#   4. Migrate existing DB:     DB_ENCRYPTION_KEY=<key> python scripts/encrypt_db.py
#   5. Set the variable below and restart.
# DB_ENCRYPTION_KEY=your-64-char-hex-key-here

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# GOOGLE_CLIENT_ID=your-google-client-id
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── OpenAI ────────────────────────────────────────────────────────────────────
# HIPAA NOTE: Requires a signed BAA (OpenAI Enterprise tier) before sending PHI.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5
# Enable LLM translation (set to "1", "true", or "yes" to activate; off by default).
# INSIDEIMAGING_ALLOW_LLM=0
# OPENAI_MAX_OUTPUT_TOKENS=512
# OPENAI_TIMEOUT=60

# ── Session ───────────────────────────────────────────────────────────────────
# Inactivity timeout in seconds. HIPAA recommends ≤ 900s (15 min) for PHI access.
SESSION_INACTIVITY_SECONDS=1800
# Total session lifetime (seconds). Default 12 hours.
# SESSION_LIFETIME_SECONDS=43200

# ── Audit logging ─────────────────────────────────────────────────────────────
AUDIT_LOG_ENABLED=true
# Ship audit logs to CloudWatch for an immutable off-host trail (recommended in production).
# AWS_CLOUDWATCH_LOG_GROUP=inside-imaging-audit
# AWS_CLOUDWATCH_LOG_STREAM=app

# ── Data retention ────────────────────────────────────────────────────────────
# HIPAA minimum retention is 6 years. Consult legal before changing.
DATA_RETENTION_YEARS=6

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Defaults to the GitHub Pages domain.
# CORS_ORIGINS=https://your-frontend-domain.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# RATELIMIT_DEFAULT=300 per hour
# RATELIMIT_STORAGE=memory://         # use redis:// in production for multi-worker
# LOGIN_RATE_LIMIT=10 per 15 minutes
# SIGNUP_RATE_LIMIT=10 per hour
# INTEGRATION_RATE_LIMIT=120 per minute

# ── Upload limits ─────────────────────────────────────────────────────────────
# MAX_UPLOAD_MB=50

# ── Password policy ───────────────────────────────────────────────────────────
# PASSWORD_MIN_LENGTH=12

# ── Integration API ───────────────────────────────────────────────────────────
# Trust X-Forwarded-For header for client IP (set to "1" behind a load balancer).
# TRUST_FORWARDED_FOR=0

# ── HL7 MLLP listener ─────────────────────────────────────────────────────────
# Port the MLLP listener binds on (Stratus sends HL7 ORU^R01 here).
# HL7_LISTENER_HOST=0.0.0.0
# HL7_LISTENER_PORT=2575
# Base URL of the Inside Imaging HTTP API (HL7 listener forwards reports here).
# INTEGRATION_BASE_URL=http://127.0.0.1:5000
# Fallback API key used when no tenant-specific key matches the HL7 Sending Facility.
# Issue with: flask apikey issue --tenant-id <id> --label hl7-fallback
# HL7_FORWARD_API_KEY=ii_int_...
# Default tenant ID to route HL7 messages to when no Sending Facility match is found.
# HL7_DEFAULT_TENANT=default
# TLS certificate/key for MLLP-over-TLS (required in production).
# HL7_TLS_CERT=/etc/ssl/inside-imaging/server.crt
# HL7_TLS_KEY=/etc/ssl/inside-imaging/server.key
# Optional: require mutual TLS by specifying a CA bundle.
# HL7_TLS_CLIENT_CA=/etc/ssl/inside-imaging/ca.crt

# ── Pricing ───────────────────────────────────────────────────────────────────
# PRICE_USD_PER_REPORT=1.00
# PRICE_KES_PER_USD=129
# TOKENS_PER_REPORT=1

# ── Server ────────────────────────────────────────────────────────────────────
# PORT=5000
